# Copy to .env and fill in. Never commit .env.
# Only NEXT_PUBLIC_* variables ever reach the browser — none are needed so far.

# --- Database (Neon) — Phase 1 ---
# Pooled connection (host contains "-pooler"); used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (no "-pooler"); used by Prisma migrations via prisma.config.ts.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Seed — Phase 1 ---
# The first admin. The seed never overwrites an existing user's password.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="at-least-8-characters"
# Optional display name (defaults to "Store Admin")
# SEED_ADMIN_NAME="Store Admin"

# --- Added in later phases (uncomment when that phase lands) ---
# AUTH_SECRET=""                       # Phase 2 — generate with: npx auth secret
# STORE_HOST="localhost:3000"          # Phase 3 — include the port locally
# ADMIN_HOST="admin.localhost:3000"    # Phase 3
# STORE_URL="http://localhost:3000"    # Phase 4/6 — full origin, used for Paystack callback + SEO
# PAYSTACK_SECRET_KEY="sk_test_..."    # Phase 6
# SHIPPING_FLAT_FEE_KOBO="250000"      # Phase 6 — integer kobo (250000 = ₦2,500)
# BLOB_READ_WRITE_TOKEN=""             # Phase 7 — Vercel Blob store token
# UPSTASH_REDIS_REST_URL=""            # Phase 8
# UPSTASH_REDIS_REST_TOKEN=""          # Phase 8
